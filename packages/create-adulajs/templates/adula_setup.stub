import { BaseCommand } from '@adonisjs/core/ace'
import { readFile } from 'node:fs/promises'
import hash from '@adonisjs/core/services/hash'

export default class Setup extends BaseCommand {
  static commandName = 'adula:setup'
  static description = 'Finish local setup using the private credentials generated by create-app'
  static options = { startApp: true }

  async run() {
    if (this.app.inProduction || this.app.inTest) throw new Error('Setup requires development mode')
    const credentials = await readFile(this.app.tmpPath('dev-admin.txt'), 'utf8')
    const email = /^Email: (.+)$/m.exec(credentials)?.[1]
    const password = /^Password: (.+)$/m.exec(credentials)?.[1]
    if (!email || !password || password.length < 24) throw new Error('Missing generated administrator credentials')
    const { default: User } = await import('#models/user')
    const { default: db } = await import('@adonisjs/lucid/services/db')
    const existing = await User.findBy('email', email)
    if (existing) {
      if (!(await hash.verify(existing.password, password))) throw new Error('Existing account does not match setup credentials')
    } else {
      if ((await User.query().first())) throw new Error('Setup cannot create an administrator in an existing application')
      await User.create({ email, password, fullName: 'مدير النظام' })
    }
    process.env.ADULA_ADMIN_EMAIL = email
    const installed = await this.kernel.exec('adula:install', [])
    if (installed.exitCode) throw new Error('AdulaJS installation failed')
    const identity = JSON.parse(await readFile(this.app.makePath('company-identity.json'), 'utf8'))
    await db.from('org_units').whereNull('parent_id').update({ name: identity.company })
    this.logger.success('Local administrator, company, managed skills and shadcn UI are ready')
  }
}
