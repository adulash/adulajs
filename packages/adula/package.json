{
  "name": "adula",
  "description": "Resource-driven business applications for AdonisJS 7",
  "version": "2.1.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "files": [
    "build",
    "!build/bin",
    "!build/tests"
  ],
  "main": "build/index.js",
  "exports": {
    ".": "./build/index.js",
    "./types": "./build/src/resource/types.js",
    "./auth": "./build/src/auth/ability.js",
    "./mcp": "./build/src/mcp/tools.js",
    "./provider": "./build/providers/adula_provider.js",
    "./commands": "./build/commands/main.js",
    "./eslint": "./build/src/eslint/index.js",
    "./migrations/*": "./build/database/migrations/*.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node ../../scripts/clean-core-build.mjs && tsc -p tsconfig.build.json && node ../../scripts/copy-core-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import=@poppinss/ts-exec bin/test.ts",
    "lint": "eslint src providers commands database tests index.ts",
    "capabilities": "node --import=@poppinss/ts-exec bin/generate_capabilities.ts"
  },
  "keywords": [
    "adonisjs",
    "business-applications",
    "arabic",
    "rtl",
    "postgresql",
    "authorization"
  ],
  "author": "adula contributors",
  "license": "MIT",
  "devDependencies": {
    "@adonisjs/assembler": "8.5.0",
    "@adonisjs/core": "7.5.0",
    "@adonisjs/drive": "4.0.0",
    "@adonisjs/eslint-config": "3.1.0",
    "@adonisjs/lucid": "22.4.2",
    "@adonisjs/tsconfig": "2.0.0",
    "@japa/assert": "4.2.0",
    "@japa/runner": "5.3.0",
    "@jrmc/adonis-mcp": "2.0.0",
    "@poppinss/ts-exec": "1.4.4",
    "@types/node": "26.2.0",
    "@types/papaparse": "5.5.2",
    "eslint": "10.9.0",
    "pg": "8.16.3",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@adonisjs/assembler": "^8.5.0",
    "@adonisjs/core": "^7.0.0",
    "@adonisjs/drive": "^4.0.0",
    "@adonisjs/lucid": "^22.0.0",
    "@jrmc/adonis-mcp": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@jrmc/adonis-mcp": {
      "optional": true
    },
    "@adonisjs/assembler": {
      "optional": true
    },
    "@adonisjs/drive": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "prettier": "@adonisjs/prettier-config",
  "dependencies": {
    "@casl/ability": "7.0.1",
    "knex": "3.3.0",
    "otpauth": "9.5.2",
    "papaparse": "5.7.0",
    "xstate": "5.33.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adulash/adulajs.git",
    "directory": "packages/adula"
  },
  "homepage": "https://github.com/adulash/adulajs/tree/main/packages/adula#readme",
  "bugs": {
    "url": "https://github.com/adulash/adulajs/issues"
  }
}
