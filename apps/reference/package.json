{
  "name": "@adula/reference",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node bin/server.js",
    "build": "node ace build",
    "dev": "node ace serve --hmr",
    "test": "node ace test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit --project inertia/tsconfig.json && tsc --noEmit --project tests/fixtures/frontend/tsconfig.json"
  },
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#models/*": "./app/models/*.js",
    "#mails/*": "./app/mails/*.js",
    "#services/*": "./app/services/*.js",
    "#listeners/*": "./app/listeners/*.js",
    "#events/*": "./app/events/*.js",
    "#generated/*": "./.adonisjs/server/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#transformers/*": "./app/transformers/*.js",
    "#validators/*": "./app/validators/*.js",
    "#providers/*": "./providers/*.js",
    "#policies/*": "./app/policies/*.js",
    "#abilities/*": "./app/abilities/*.js",
    "#database/*": "./database/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js",
    "#modules/*": "./app/modules/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "8.5.0",
    "@adonisjs/eslint-config": "3.1.0",
    "@adonisjs/prettier-config": "1.5.0",
    "@adonisjs/tsconfig": "2.0.0",
    "@japa/api-client": "3.2.1",
    "@japa/assert": "4.2.0",
    "@japa/browser-client": "2.3.0",
    "@japa/plugin-adonisjs": "5.2.0",
    "@japa/runner": "5.3.0",
    "@poppinss/ts-exec": "1.4.4",
    "@tailwindcss/vite": "4.3.3",
    "@types/luxon": "3.7.5",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "eslint": "10.9.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "hot-hook": "1.0.0",
    "otpauth": "9.5.2",
    "pino-pretty": "13.1.3",
    "playwright": "1.63.0",
    "prettier": "3.9.6",
    "shadcn": "4.21.0",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "youch": "4.1.1"
  },
  "dependencies": {
    "@adonisjs/ally": "6.3.0",
    "@adonisjs/auth": "10.1.0",
    "@adonisjs/cache": "2.1.0",
    "@adonisjs/core": "7.5.0",
    "@adonisjs/cors": "3.0.0",
    "@adonisjs/drive": "4.0.0",
    "@adonisjs/inertia": "5.0.1",
    "@adonisjs/limiter": "3.0.1",
    "@adonisjs/lucid": "22.4.2",
    "@adonisjs/mail": "10.4.0",
    "@adonisjs/redis": "10.0.2",
    "@adonisjs/session": "8.1.0",
    "@adonisjs/shield": "9.0.0",
    "@adonisjs/static": "2.0.1",
    "@adonisjs/transmit": "3.0.2",
    "@adonisjs/transmit-client": "1.1.0",
    "@adonisjs/vite": "6.0.1",
    "adula": "workspace:*",
    "@adula/ui": "workspace:*",
    "@aws-sdk/client-s3": "3.1134.0",
    "@aws-sdk/s3-request-presigner": "3.1134.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@inertiajs/core": "3.7.1",
    "@inertiajs/react": "3.7.0",
    "@jrmc/adonis-attachment": "5.2.1",
    "@jrmc/adonis-mcp": "2.0.0",
    "@nemoventures/adonis-jobs": "2.2.0",
    "@tanstack/react-table": "9.2.4",
    "@tanstack/react-virtual": "3.14.13",
    "@tuyau/core": "1.2.2",
    "@vinejs/vine": "4.4.0",
    "adonisjs-scheduler": "2.8.0",
    "axios": "1.19.0",
    "bullmq": "5.81.5",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.3.0",
    "date-fns": "4.4.0",
    "edge.js": "6.5.1",
    "lucide-react": "1.47.0",
    "luxon": "3.7.2",
    "pg": "8.16.3",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-day-picker": "10.0.1",
    "react-dom": "19.2.8",
    "react-hook-form": "7.88.0",
    "reflect-metadata": "0.2.2",
    "sonner": "2.0.8",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  },
  "prettier": "@adonisjs/prettier-config"
}
